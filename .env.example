# Load explicitly with: uv run weather --env-file .env
# Existing process environment variables take precedence over this file.
RSS_FILE_PATH=./weather_feed.xml
IMAGE_FILE_PATH=./img

# Both Slack and Discord destinations are required.
SLACK_TOKEN=
UPLOAD_CHANNEL=
DISCORD_WEBHOOK_URL=

# Optional settings.
# LOG_FILE=./weather.log
THRESHOLD=0.001
PIXEL_TOLERANCE=16

# Deprecated and unused; no longer required.
# SLACK_WEBHOOK_URL=
